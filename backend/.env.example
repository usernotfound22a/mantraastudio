# ---------------------------------------------------------------------------
# SocialHub - backend environment
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# NEVER commit the real `.env` to git.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# --- Supabase ---------------------------------------------------------------
# Use the same project URL and publishable key as the frontend. The backend
# also accepts the existing NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY names as aliases.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for trusted server-side webhooks/worker operations only. Never use
# a NEXT_PUBLIC_ prefix or expose this value to the browser.
SUPABASE_SECRET_KEY=

# --- OAuth state + encryption fallback -------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_development_secret_at_least_32_characters_long
# Runs = bcrypt cost factor. 10 is fine for a FYP demo, 12+ in production.
BCRYPT_ROUNDS=10

# --- Facebook / Meta OAuth (Messenger + Instagram) -------------------------
# Create an app at https://developers.facebook.com and add the "Messenger",
# "Instagram Messaging" and "WhatsApp" products; business permissions may need review.
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Public HTTPS callback URL for the server-side Meta OAuth redirect.
META_REDIRECT_URI=
# If you use a dedicated Instagram Login flow, this must match Instagram app settings.
META_INSTAGRAM_REDIRECT_URI=
# Public tunnel URL used for the webhooks, e.g. https://abc123.ngrok.io
WEBHOOK_BASE_URL=
# Required app compliance URLs for Meta app review.
META_PRIVACY_POLICY_URL=
META_DEAUTH_CALLBACK_URL=
META_DATA_DELETION_URL=
# Any random string you choose. Facebook echoes it back on webhook verification.
META_VERIFY_TOKEN=change_me_verify_token

# --- AI service ------------------------------------------------------------
# Provider: "openai" | "groq" | "offline"
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Similarity threshold (0..1) for FAQ match confidence before the AI answers.
AI_CONFIDENCE_THRESHOLD=0.55
AI_MAX_TOKENS=400

# --- Stripe (test mode) ----------------------------------------------------
# Test keys start with sk_test_ / pk_test_ and never charge real money.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx

# --- Khalti refunds --------------------------------------------------------
# Keep the merchant live secret on the server; use the test key with the dev URL.
KHALTI_SECRET_KEY=
KHALTI_API_BASE_URL=https://khalti.com/api

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Plugins -----------------------------------------------------------------
# Third-party channel plugins are loaded from backend/plugins by default. Point
# this somewhere else to keep them outside the repo.
# CHANNEL_PLUGINS_DIR=C:\socialhub-plugins
# Example plugin channels may also want a server-side default, e.g.
# TELEGRAM_BOT_TOKEN=

# --- Security ----------------------------------------------------------------
# 32-byte key used to encrypt webhook signing secrets at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, JWT_SECRET is reused as the encryption key, which is fine for a local
# demo but means rotating JWT_SECRET also rotates webhook secrets.
ENCRYPTION_KEY=

# --- Outbound webhooks -------------------------------------------------------
# Used to build the webhook URL shown in Settings -> Webhooks.
WEBHOOK_BASE_URL=
# Attempts per delivery before the endpoint is auto-disabled.
WEBHOOK_MAX_ATTEMPTS=5
# Per-request timeout for a delivery.
WEBHOOK_TIMEOUT_MS=10000
# How often the background worker looks for due deliveries.
WEBHOOK_POLL_INTERVAL_MS=15000