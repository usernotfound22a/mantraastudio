{
  "name": "socialhub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SocialHub - AI-Assisted Omnichannel Inbox. Express + Socket.IO + Supabase API.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:migrate": "node scripts/migrate.js && npx supabase migration up --local",
    "db:check-schema": "node scripts/migrate.js",
    "db:reset": "node scripts/migrate.js && npx supabase db reset",
    "check": "node scripts/check-env.js",
    "routes": "node scripts/routes.js",
    "verify:analytics": "node scripts/verify-analytics.js",
    "verify:plugins": "node scripts/verify-plugins.mjs",
    "verify:api": "node scripts/verify-public-api.mjs",
    "verify:channels": "node scripts/verify-channels.mjs",
    "verify:meta-config": "node scripts/verify-meta-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.100.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "openai": "^4.77.0",
    "pdfkit": "^0.15.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0"
  }
}
